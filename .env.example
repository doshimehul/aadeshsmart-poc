# PostgreSQL for local development (Docker Compose)
POSTGRES_DB=aadeshsmart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# API connection from your host machine
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aadeshsmart

APP_NAME=AadeshSmart API
LOG_LEVEL=INFO
# Comma-separated list
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI processing defaults to mock mode; live mode requires the corresponding key.
SARVAM_MODE=mock
SARVAM_API_KEY=
SARVAM_TIMEOUT_SECONDS=45
GEMINI_MODE=mock
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
